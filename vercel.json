{
  "buildCommand": null,
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sentiment-meter-production.up.railway.app/api/:path*" }
  ],
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}